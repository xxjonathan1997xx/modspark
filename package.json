{
  "name": "modspark",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source manager for community game trainer packages.",
  "main": "electron/main.cjs",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test",
    "catalog": "node scripts/catalog-tool.cjs",
    "dist": "vite build && electron-builder --config electron-builder.config.cjs --publish never",
    "release": "vite build && electron-builder --config electron-builder.config.cjs --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "author": "ModSpark contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/xxjonathan1997xx/modspark.git"
  },
  "homepage": "https://github.com/xxjonathan1997xx/modspark"
}
